{
    "name": "mini-trainer-engine",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "node scripts/prepare-dev.mjs",
        "build": "node scripts/build-app.mjs",
        "build:pwa": "node scripts/build-app.mjs --pwa",
        "build:all": "node scripts/build-all-apps.mjs --both",
        "build:all:usb": "node scripts/build-all-apps.mjs",
        "build:all:pwa": "node scripts/build-all-apps.mjs --pwa",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
        "validate": "node scripts/validate-config.mjs",
        "add-exercise": "node scripts/add-exercise.mjs",
        "clean": "rm -rf dist node_modules/.vite"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "i18next": "^24.2.2",
        "idb": "^8.0.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^15.4.0",
        "react-router-dom": "^6.28.2",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@playwright/test": "1.56.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.1.0",
        "@types/node": "25.3.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "8.56.1",
        "@typescript-eslint/parser": "8.56.1",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^4.0.18",
        "autoprefixer": "10.4.27",
        "eslint": "^9.39.2",
        "jsdom": "^28.1.0",
        "postcss": "8.5.8",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.6.3",
        "vite": "^6.0.5",
        "vitest": "^4.0.18",
        "zod": "^3.25.76"
    },
    "engines": {
        "node": ">=20"
    }
}
